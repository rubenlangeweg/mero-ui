{
  "name": "@rubenlangeweg/mero-ui",
  "version": "0.5.1",
  "type": "module",
  "description": "HTML components and HTMX patterns for server-rendered interfaces.",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "test": "node --test",
    "audit:catalog": "node scripts/audit-catalog.mjs",
    "pack:ui": "npm pack --dry-run",
    "build": "node scripts/build-assets.mjs && cf build",
    "deploy": "npm run build && cf deploy --prebuilt"
  },
  "exports": {
    "./charts": "./ui/insight-charts.mjs",
    "./markdown": "./ui/insight-markdown.mjs",
    "./ui/*": "./ui/*",
    "./package.json": "./package.json"
  },
  "files": [
    "ui",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-rc.2",
    "axe-core": "^4.14.1",
    "cf": "1.0.0-rc.2",
    "playwright": "^1.65.1",
    "vite": "8.3.8"
  },
  "homepage": "https://mero-ui.rubenlangeweg.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rubenlangeweg/mero-ui.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
